{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta-Aware Causal Delta Execution Receipt",
  "type": "object",
  "required": ["schema_version", "cycle", "intent", "operation", "timestamp", "status", "evidence", "verification"],
  "properties": {
    "schema_version": {"type": "string"},
    "cycle": {"type": "integer", "minimum": 0},
    "intent": {"type": "string"},
    "operation": {"type": "string"},
    "actor": {"type": "string"},
    "tool": {"type": "string"},
    "inputs": {"type": "object", "additionalProperties": true},
    "outputs": {"type": "object", "additionalProperties": true},
    "timestamp": {"type": "string", "format": "date-time"},
    "status": {"enum": ["IDEA", "STAGED", "IMPLEMENTED", "EXECUTED", "TESTED", "BENCHMARKED", "REPRODUCED", "VERIFIED", "BLOCKED", "FAILED"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["UNVERIFIED", "PARTIAL", "VERIFIED"]},
        "method": {"type": "string"},
        "result": {"type": "string"}
      },
      "additionalProperties": false
    },
    "baseline": {"type": "object", "additionalProperties": true},
    "causal_delta": {"type": "object", "additionalProperties": true},
    "provenance": {"type": "object", "additionalProperties": true},
    "friction": {"type": "object", "additionalProperties": true},
    "failure": {"type": ["object", "null"], "additionalProperties": true},
    "next_hypothesis": {"type": ["string", "null"]},
    "meta_aware": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
